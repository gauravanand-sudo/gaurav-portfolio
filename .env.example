# Lead delivery (private)
LEAD_NOTIFY_EMAIL=your-real-inbox@example.com

# Public professional mailbox. Configure after creating your domain mailbox.
PUBLIC_SALES_EMAIL=hello@yourdomain.com

# Optional live booking page (Cal.com, Calendly, etc.)
BOOKING_URL=

# Optional CRM webhook (HubSpot/Attio/Make/Zapier/custom)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional marketing/nurture webhook
MARKETING_WEBHOOK_URL=
MARKETING_WEBHOOK_SECRET=

# Optional first-party event analytics webhook
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_SECRET=

# Optional Google Analytics 4 measurement ID. Leave empty to keep only first-party tracking.
NEXT_PUBLIC_GA_ID=
